owner_login              = "your-github-username"
telegram_allowed_user_id = "12345678"

# Git author identity (issue #119). Every agent run on this pool —
# EC2 runtime + GHA worker — uses these values for its commits.
# Leave both unset to use the audit-friendly defaults derived from
# owner_login (git_author_name = owner_login, git_author_email =
# "<owner_login>@users.noreply.github.com"). Override only when
# you need a different identity, e.g. the canonical
# `release-bot <release-bot@users.noreply.github.com>` carve-out
# for [skip ci] bumps.
#
# git_author_name  = "release-bot"
# git_author_email = "release-bot@users.noreply.github.com"
#
# To attribute to a human, use the audit-friendly form
# `<sender_id>+<login>@users.noreply.github.com` (find the id with
# `gh api /users/<login> --jq .id`):
#
# git_author_name  = "your-github-username"
# git_author_email = "12345678+your-github-username@users.noreply.github.com"

telegram_bot_tokens = {
  bot1 = "<BOT_TOKEN>"
  bot2 = "<BOT_TOKEN>"
}

# Optional: route this user's agents to a local LLM reachable from the
# EC2 spot instance. All fields below are optional; omit the block entirely
# to use the cloud provider default.
#
# Constraints:
#   - local_llm_endpoint must resolve to a private IP (RFC1918, ULA, or
#     Tailscale CGNAT 100.64.0.0/10). Public IPs are hard-rejected at the
#     Lambda. Set local_llm_endpoint_allow_private_cidrs = true when using
#     any of those ranges.
#   - local_llm_model is required when local_llm_endpoint is set; it becomes
#     the suffix of OPENCODE_MODEL=local/<model>.
#   - local_llm_api_key may be empty for endpoints without auth.
#   - local_llm_fallback only takes effect in assisted mode. Autonomous runs
#     always abort when the local LLM is unreachable.
#   - tailscale_auth_key, when set, makes the EC2 spot instance enroll in
#     your Tailscale Tailnet on every run (ephemeral, auto-removed when
#     the instance terminates). Generate at
#     https://login.tailscale.com/admin/settings/keys with
#       Ephemeral: enabled
#       Reusable: enabled
#       Tags: tag:blitzlog-agent
#     Your Tailnet ACL must grant tag:blitzlog-agent access to the LLM
#     endpoint's Tailnet IP. Skip this variable when using a static subnet
#     router, exit node, or AWS Client VPN instead.
#
# local_llm_endpoint                       = "http://100.x.y.z:11434"
# local_llm_model                          = "qwen2.5-coder:32b"
# local_llm_api_key                        = ""
# local_llm_endpoint_allow_private_cidrs   = true
# local_llm_fallback                       = "closed"
# tailscale_auth_key                       = "tskey-auth-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Optional: bring your own inference model + credential (issue #165).
#
# Three levels of model selection, resolved per run — the higher
# supersedes the lower:
#
#   1. per task   — a `model:<value>` issue label (see the README)
#   2. per user   — the values below        <-- you are here
#   3. per org    — the deployment default (var.opencode_model)
#
# The credential resolves on its own axis and supersedes the org's:
# per-user credential -> org credential. A credential is only ever
# used with a model whose provider matches it; a mismatch fails the
# run fast rather than sending your key to the wrong provider.
#
# Constraints:
#   - opencode_model is `provider/model` (e.g. anthropic/claude-sonnet-4).
#     Leave it empty to run the org's default model.
#   - opencode_api_key is YOUR credential. Leave it empty to use the
#     org's credential. The key is stored as a SecureString; the
#     Lambda never reads it — the EC2 host fetches it from the path.
#   - opencode_api_key_provider declares which provider your key
#     belongs to. It defaults to the provider prefix of
#     opencode_model. Set it EXPLICITLY when opencode_model is empty:
#     your key then runs the org's default model, which only works
#     when the two providers match.
#   - opencode_base_url is for a self-hosted / BYO endpoint. It
#     requires opencode_api_key — the org credential is never sent
#     to a custom endpoint. Must resolve to a public IP, or to a
#     private one with opencode_base_url_allow_private_cidrs = true.
#     Loopback and link-local (the instance metadata service) are
#     always rejected.
#
# opencode_model                           = "anthropic/claude-sonnet-4"
# opencode_api_key                         = "sk-ant-xxxxxxxxxxxxxxxx"
# opencode_api_key_provider                = "anthropic"
# opencode_base_url                        = "https://llm.internal/v1"
# opencode_base_url_allow_private_cidrs    = true
