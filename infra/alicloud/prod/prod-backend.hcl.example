# Alicloud OSS backend config for the prod env.
#
# Mirror of infra/aws/prod/prod-backend.hcl.example. The OSS bucket
# must be created manually (or via the bootstrap stack at
# infra/alicloud/bootstrap/) before `terraform init`.
#
# Issue #191: the key is pinned to the shared `blitzlog/<env>.tfstate`
# layout (same key the AWS S3 backend uses), and `prefix = ""` stops
# the OSS backend from prepending its default `env:` directory — with
# the default prefix the object would resolve to
# `env:/blitzlog/prod.tfstate`, which does not exist.
#
# Usage:
#   terraform init -input=false \
#     -backend-config=infra/alicloud/prod/prod-backend.hcl

bucket = "blitzlog-prod-tfstate"
key    = "blitzlog/prod.tfstate"
prefix = ""
region = "cn-hangzhou"
