# Alicloud OSS backend config for the bootstrap stack.
#
# Mirror of infra/aws/bootstrap/terraform.dev.auto.tfvars.example's
# sibling. The OSS bucket must exist before `terraform init` — backend
# init does NOT create the bucket.
#
# Usage:
#   cp bootstrap-backend.hcl.example bootstrap-backend.hcl
#   terraform init -backend-config=bootstrap-backend.hcl
#
# The bucket + region below are the REAL ones for the blitzlog
# Alicloud account. The dev/prod stacks share the SAME bucket (keyed
# per-env), so there is one state bucket for the whole Alicloud
# deployment.
#
# CREDENTIALS. The `oss` backend needs an Alicloud credential. It
# resolves them in this order:
#   1. `-backend-config="access_key=..." -backend-config="secret_key=..."`
#   2. the ALICLOUD_ACCESS_KEY / ALICLOUD_SECRET_KEY env vars (or
#      the ALIBABA_CLOUD_* equivalents)
#   3. the `profile` setting below, which reads
#      `~/.aliyun/config.json`
#
# Option 3 is the local-dev path. `aliyun configure --profile
# <name>` writes `~/.aliyun/config.json`; the profile name must
# match the `profile` key below.
#
# NOTE: the region MUST match the bucket's region. The state bucket
# lives in cn-hongkong — an OSS bucket name is globally unique, but
# its region is not, so pointing the backend at another region
# fails with "Authorization header is invalid" or a 404.

bucket = "gwc-infra-tf-state"
key    = "blitzlog/bootstrap.tfstate"
region = "cn-hongkong"
profile = "default"
