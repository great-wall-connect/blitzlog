# Production Blitzlog environment.
#
# Run from this directory:
#
#   terraform init -backend-config=prod-backend.hcl
#   terraform plan
#   terraform apply
#
# Resources provisioned: blitzlog-prod-handler Lambda, blitzlog-prod-webhook-api,
# blitzlog-prod-* IAM roles, blitzlog-prod-agent-sg, s3://<agent_logs_bucket>/prod/...,
# and SSM params under /blitzlog/prod/*.
#
# BUCKETS: both agent_logs and stt_models are owned by the infra/aws/bootstrap/
# stack (one-time setup; see README "Bootstrap"). Both prod and dev reference
# the SAME bucket names below; per-env logs land under s3://<bucket>/prod/...
# because the EC2 instance role is IAM-scoped to that prefix.
#
# Use a dedicated "Blitzlog Prod" GitHub App here — distinct from the App used
# in infra/aws/dev/. Each user provisions their own bot pool via the user-pool
# sub-module of the core module (see README "Environments (prod / dev)").
#
# Required variables (no defaults — Terraform apply will fail without these):
# ------------------------------------------------------------------------------
aws_region                 = "ap-east-1"                         # any AWS region with spot capacity
vpc_id                     = "vpc-0123456789abcdef0"             # VPC where the agent EC2 instance will launch
ec2_subnet_id              = "subnet-0123456789abcdef0"          # public subnet inside vpc_id
github_app_id              = "123456"                            # GitHub App numeric ID (prod App)
github_app_private_key     = "LS0tLS1CRUdJTi..."                 # base64-encoded PEM of the App's private key
github_app_installation_id = "987654"                            # GitHub App installation ID for the prod repos
github_webhook_secret      = "replace-with-a-long-random-string" # HMAC secret you also paste into the GitHub webhook config
opencode_api_key           = "sk-cp-..."                         # API key for the OpenCode inference provider
agent_logs_bucket_name     = "gwc-blitzlog-agent-logs"           # MUST match infra/aws/bootstrap/terraform.tfvars

# Optional variables (uncomment to override defaults):
# ------------------------------------------------------------------------------
# ssh_allowed_cidrs         = ["1.2.3.4/32"]                     # CIDRs allowed SSH ingress; empty = no SSH
# alert_email               = "dev-team@example.com"             # CloudWatch alarm email; empty = no email subscription
# opencode_model            = "minimax-coding-plan/MiniMax-M3"   # provider/model ID passed to the OpenCode CLI on EC2
# opencode_agent_max_steps  = 500                                # Max opencode iterations per session before forcing summarization. Raise for large multi-file tasks; lower for cost-sensitive runs.

# Issue #165: the three-level model selection.
#
#   opencode_api_key_provider  — the provider your key belongs to. A
#     credential is only ever used with a model whose provider matches
#     it. Defaults to the provider prefix of opencode_model.
# opencode_api_key_provider   = "minimax-coding-plan"
#
#   opencode_model_profiles — operator-registered aliases, selectable
#     per task with a `model:<alias>` issue label. The alias is chosen
#     by whoever labels the issue, so only register aliases you are
#     happy to expose.
# opencode_model_profiles = {
#   fast = {
#     model = "minimax-coding-plan/MiniMax-M2"
#   }
#   internal = {
#     model    = "anthropic/claude-sonnet-4"
#     base_url = "https://llm.internal/v1"
#   }
# }
#
#   opencode_allowed_providers — providers a raw
#     `model:<provider>/<model>` label may name. Arbitrary endpoints
#     are never reachable from a label. Empty means raw labels are
#     rejected and only aliases are selectable.
# opencode_allowed_providers = ["minimax-coding-plan"]
# stt_api_url               = "http://127.0.0.1:7878/v1"        # Whisper-compatible endpoint for the Telegram bot
# stt_api_key               = "any-non-empty-string"            # Forwarded to the STT provider; localhost shim ignores it
# stt_model                 = "base.en"                          # Whisper model name; must match a file uploaded to the shared STT bucket
# stt_language              = "en"                               # Whisper language hint; "" = auto-detect
# upload_stt_model          = false                              # Auto-upload whisper model from HuggingFace on `terraform apply`. Idempotent — skips if the object already exists in the shared bucket.
# stt_model_source_url      = "https://huggingface.co/ggerganov/whisper.cpp/resolve/main"
# stt_models_bucket_name    = "gwc-blitzlog-stt-models"          # MUST match infra/aws/bootstrap/terraform.tfvars (shared with dev)
# aws_profile               = "terraform"                        # Pin the AWS profile used by the upload provisioner
# spot_instance_types       = ["t4g.medium", "t4g.large", "t4g.xlarge"]  # Override for regions without Arm spot inventory; passed to the Lambda as SPOT_INSTANCE_TYPES_JSON. Order = preference order.

# Per-user Telegram bot pools (assisted mode)
# ------------------------------------------------------------------------------
# Each user provisions their own pool by running the user-pool sub-module
# of infra/aws/modules/core/user-pool/ locally, passing `environment = "prod"`.
# See README.md, "Per-user bot pool setup (assisted mode)", for the full walkthrough.

# Per-user local LLM routing (assisted or autonomous)
# ------------------------------------------------------------------------------
# Add the local_llm_* variables to infra/user-pool/terraform.tfvars to point
# this user's agents at a local LLM reachable from the EC2 instance. The
# endpoint must resolve to a private IP (RFC1918, ULA, or Tailscale CGNAT);
# public IPs are hard-rejected at the Lambda. See README.md,
# "Local LLMs (route agents to a model you control)", for the full walkthrough
# including the three always-on transports (Tailscale, WireGuard, AWS Client VPN).

# Terraform state bucket (supplied at init time, not via tfvars):
# ------------------------------------------------------------------------------
# The S3 backend bucket is intentionally NOT a tfvars variable —
# Terraform cannot evaluate input variables inside the backend block.
# Supply it instead via a -backend.hcl file (gitignored), e.g.:
#
#   # infra/prod-backend.hcl
#   bucket = "<your-terraform-state-bucket>"
#
# then run:
#
#   terraform init -backend-config=infra/prod-backend.hcl
#
# See README.md for the full setup walkthrough.

# State file: S3 key is "prod/blitzlog.tfstate" in the bucket named in prod-backend.hcl.
# Migrate the legacy single-key state ("blitzlog.tfstate") with:
#   terraform init -migrate-state -backend-config=prod-backend.hcl

# ---------------------------------------------------------------------------
# Scrummaster (epic #134)
# ---------------------------------------------------------------------------
# The long-lived Scrummaster advisor host: a t4g.nano running dockerd + one
# ZeroClaw container per user-pool user. Read-only over GitHub issues / PRs /
# S3 session artifacts, answers you over Telegram, and is the only agent role
# permitted to apply the `autonomous` / `assisted` trigger labels.
#
# Env-scoped: prod gets its own host, IAM objects and AMI, published to
# /blitzlog/prod/agent-ami-id-zeroclaw-docker-ubuntu. Dev has its own under
# /blitzlog/dev/. Nothing collides.
#
# Requires a Packer bake FIRST — the release workflow does this for you on
# every `pr-test` (dev) and `release` (prod) dispatch.
#
# Enable with:
#   enable_scrummaster = true
#   zeroclaw_image_tag = "default-features-v0.8.6"
enable_scrummaster = false

# Must match the -var zeroclaw_image_tag the AMI was baked with. The module
# refuses to launch an AMI whose ZeroclawTag differs.
zeroclaw_image_tag = "default-features-v0.8.6"

# Operator access. Disabled by default so the instance has no public IP and
# port 22 ingress is closed unless explicitly enabled.
enable_scrummaster_eip = false
ssh_key_name           = ""
