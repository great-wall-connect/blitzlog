# Development Blitzlog environment.
#
# Run from this directory:
#
#   terraform init -backend-config=dev-backend.hcl
#   terraform plan
#   terraform apply
#
# Resources provisioned: blitzlog-dev-handler Lambda, blitzlog-dev-webhook-api,
# blitzlog-dev-* IAM roles, blitzlog-dev-agent-sg, s3://<agent_logs_bucket>/dev/...,
# and SSM params under /blitzlog/dev/*.
#
# CRITICAL: Use a dedicated "Blitzlog Dev" GitHub App here — distinct from prod.
# Install the dev App on a throwaway sandbox repo (e.g. great-wall-connect/blitzlog-dev-sandbox)
# and point the repo's webhook at `terraform output webhook_url` for this dev stack.
# Real production users' webhooks still point at the prod stack — they cannot
# be affected by changes here.
#
# The dev Lambda role's IAM policy only allows reads from /blitzlog/dev/*, so a
# misconfigured dev webhook cannot impersonate the prod GitHub App.
#
# BUCKETS: both agent_logs and stt_models are owned by the infra/aws/bootstrap/
# stack (see README "Bootstrap"). Both prod and dev reference the SAME bucket
# by name; the names below MUST match what infra/aws/bootstrap/ provisioned.
# Dev logs land under s3://<bucket>/dev/<repo>/issue/<N>/... — the dev EC2
# instance role is IAM-scoped to read/write only the dev/ prefix.
#
# Required variables (no defaults — Terraform apply will fail without these):
# ------------------------------------------------------------------------------
aws_region                 = "ap-east-1"                         # any AWS region with spot capacity
vpc_id                     = "vpc-0123456789abcdef0"             # reuse the prod VPC, or pick a separate one
ec2_subnet_id              = "subnet-0123456789abcdef0"          # public subnet inside vpc_id
github_app_id              = "123456"                            # GitHub App numeric ID (dev App — NOT the prod App)
github_app_private_key     = "LS0tLS1CRUdJTi..."                 # base64-encoded PEM of the dev App's private key
github_app_installation_id = "987654"                            # GitHub App installation ID for the sandbox repo
github_webhook_secret      = "replace-with-a-long-random-string" # HMAC secret you also paste into the GitHub webhook config
opencode_api_key           = "sk-cp-..."                         # API key for the OpenCode inference provider used by dev agents
agent_logs_bucket_name     = "gwc-blitzlog-agent-logs"           # SAME bucket as prod (owned by infra/aws/bootstrap/)

# Optional variables (uncomment to override defaults):
# ------------------------------------------------------------------------------
# ssh_allowed_cidrs         = ["1.2.3.4/32"]                     # CIDRs allowed SSH ingress to dev instances
# alert_email               = "dev-team@example.com"             # CloudWatch alarm email
# opencode_model            = "minimax-coding-plan/MiniMax-M3"   # provider/model ID passed to the dev OpenCode CLI
# opencode_agent_max_steps  = 500                                # Max opencode iterations per session before forcing summarization. Raise for large multi-file tasks; lower for cost-sensitive runs.

# Issue #165: the three-level model selection.
#
#   opencode_api_key_provider  — the provider your key belongs to. A
#     credential is only ever used with a model whose provider matches
#     it. Defaults to the provider prefix of opencode_model.
# opencode_api_key_provider   = "minimax-coding-plan"
#
#   opencode_model_profiles — operator-registered aliases, selectable
#     per task with a `model:<alias>` issue label. The alias is chosen
#     by whoever labels the issue, so only register aliases you are
#     happy to expose.
# opencode_model_profiles = {
#   fast = {
#     model = "minimax-coding-plan/MiniMax-M2"
#   }
#   internal = {
#     model    = "anthropic/claude-sonnet-4"
#     base_url = "https://llm.internal/v1"
#   }
# }
#
#   opencode_allowed_providers — providers a raw
#     `model:<provider>/<model>` label may name. Arbitrary endpoints
#     are never reachable from a label. Empty means raw labels are
#     rejected and only aliases are selectable.
# opencode_allowed_providers = ["minimax-coding-plan"]
# stt_api_url               = "http://127.0.0.1:7878/v1"
# stt_api_key               = "any-non-empty-string"
# stt_model                 = "base.en"                          # Whisper model name; model already in the shared bucket if you ran `upload_stt_model = true` against prod or dev
# stt_language              = "en"
# upload_stt_model          = false                              # Auto-upload whisper model from HuggingFace on `terraform apply`. Idempotent — skips if the object already exists.
# stt_model_source_url      = "https://huggingface.co/ggerganov/whisper.cpp/resolve/main"
# stt_models_bucket_name    = "gwc-blitzlog-stt-models"          # SAME bucket as prod by default; override only if you provisioned a separate one via infra/aws/bootstrap/
# aws_profile               = "terraform"                        # Pin the AWS profile used by the upload provisioner
# spot_instance_types       = ["t4g.medium", "t4g.large", "t4g.xlarge"]  # Override for regions without Arm spot inventory; passed to the Lambda as SPOT_INSTANCE_TYPES_JSON. Order = preference order.

# Per-user Telegram bot pools (assisted mode)
# ------------------------------------------------------------------------------
# Each user provisions their own pool by running the user-pool sub-module of
# infra/aws/modules/core/user-pool/ locally, passing `environment = "dev"` so its
# SSM parameters land under /blitzlog/dev/users/<login>/... — never colliding
# with prod bot tokens.

# State file: S3 key is "dev/blitzlog.tfstate" in the bucket named in dev-backend.hcl.
# The dev state is independent of prod state — concurrent applies to both
# environments do not contend on a DynamoDB lock.

# ---------------------------------------------------------------------------
# Scrummaster (epic #134)
# ---------------------------------------------------------------------------
# The long-lived Scrummaster advisor host: a t4g.nano running dockerd + one
# ZeroClaw container per user-pool user. Read-only over GitHub issues / PRs /
# S3 session artifacts, answers you over Telegram, and is the only agent role
# permitted to apply the `autonomous` / `assisted` trigger labels.
#
# Requires a Packer bake FIRST — the release workflow does this for you in
# parallel with the agent AMI, on every `pr-test` (dev) dispatch:
#   packer build -var environment=dev \
#                  scrummaster-zeroclaw-docker-ubuntu.pkr.hcl
# That publishes the AMI id to
# /blitzlog/dev/agent-ami-id-zeroclaw-docker-ubuntu, which this module
# reads at plan time.
#
# Env-scoped: dev gets its own host, IAM objects and AMI. Prod has its own
# under /blitzlog/prod/. Nothing collides.
#
# Enable with:
#   enable_scrummaster = true
#   zeroclaw_image_tag = "default-features-v0.8.6"
#
# Then: infra/aws/modules/core/scrummaster/tests/smoketest.sh
enable_scrummaster = false

# Must match the -var zeroclaw_image_tag the AMI was baked with. The module
# refuses to launch an AMI whose ZeroclawTag differs.
zeroclaw_image_tag = "default-features-v0.8.6"

# Operator access. Disabled by default so the instance has no public IP and
# port 22 ingress is closed unless explicitly enabled.
enable_scrummaster_eip = false
ssh_key_name           = ""
