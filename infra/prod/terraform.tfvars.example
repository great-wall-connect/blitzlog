# Production Blitzlog environment.
#
# Run from this directory:
#
#   terraform init -backend-config=prod-backend.hcl
#   terraform plan
#   terraform apply
#
# Resources provisioned: blitzlog-prod-handler Lambda, blitzlog-prod-webhook-api,
# blitzlog-prod-* IAM roles, blitzlog-prod-agent-sg, s3://<agent_logs_bucket>/prod/...,
# blitzlog-prod-stt-models S3 bucket, and SSM params under /blitzlog/prod/*.
#
# Use a dedicated "Blitzlog Prod" GitHub App here — distinct from the App used
# in infra/dev/. Each user provisions their own bot pool via the user-pool
# sub-module of the core module (see README "Environments (prod / dev)").
#
# Required variables (no defaults — Terraform apply will fail without these):
# ------------------------------------------------------------------------------
aws_region                 = "ap-east-1"                         # any AWS region with spot capacity
vpc_id                     = "vpc-0123456789abcdef0"             # VPC where the agent EC2 instance will launch
ec2_subnet_id              = "subnet-0123456789abcdef0"          # public subnet inside vpc_id
github_app_id              = "123456"                            # GitHub App numeric ID (prod App)
github_app_private_key     = "LS0tLS1CRUdJTi..."                 # base64-encoded PEM of the App's private key
github_app_installation_id = "987654"                            # GitHub App installation ID for the prod repos
github_webhook_secret      = "replace-with-a-long-random-string" # HMAC secret you also paste into the GitHub webhook config
opencode_api_key           = "sk-cp-..."                         # API key for the OpenCode inference provider
agent_logs_bucket_name     = "your-agent-logs-bucket"            # S3 bucket holding agent run logs + session archives (must exist beforehand)

# Optional variables (uncomment to override defaults):
# ------------------------------------------------------------------------------
# ssh_allowed_cidrs         = ["1.2.3.4/32"]                     # CIDRs allowed SSH ingress; empty = no SSH
# alert_email               = "dev-team@example.com"             # CloudWatch alarm email; empty = no email subscription
# opencode_model            = "minimax-coding-plan/MiniMax-M3"   # provider/model ID passed to the OpenCode CLI on EC2
# stt_api_url               = "http://127.0.0.1:7878/v1"        # Whisper-compatible endpoint for the Telegram bot
# stt_api_key               = "any-non-empty-string"            # Forwarded to the STT provider; localhost shim ignores it
# stt_model                 = "base.en"                          # Whisper model name; must match a file uploaded to blitzlog-prod-stt-models
# stt_language              = "en"                               # Whisper language hint; "" = auto-detect
# upload_stt_model          = false                              # Auto-upload whisper model from HuggingFace on `terraform apply`
# stt_model_source_url      = "https://huggingface.co/ggerganov/whisper.cpp/resolve/main"
# stt_models_bucket_name    = "blitzlog-prod-stt-models"         # S3 bucket for whisper.cpp models; must be globally unique across AWS
# aws_profile               = "terraform"                        # Pin the AWS profile used by the upload provisioner

# Per-user Telegram bot pools (assisted mode)
# ------------------------------------------------------------------------------
# Each user provisions their own pool by running the user-pool sub-module
# of infra/modules/core/user-pool/ locally, passing `environment = "prod"`.
# See README.md, "Per-user bot pool setup (assisted mode)", for the full walkthrough.

# State file: S3 key is "prod/blitzlog.tfstate" in the bucket named in prod-backend.hcl.
# Migrate the legacy single-key state ("blitzlog.tfstate") with:
#   terraform init -migrate-state -backend-config=prod-backend.hcl
