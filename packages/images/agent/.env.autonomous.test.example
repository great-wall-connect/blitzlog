# packages/images/agent/.env.autonomous.test — sample env for local autonomous smoke.
# This file is gitignored. Mode is always autonomous. No STT/Telegram vars
# needed (autonomous never starts the shim or the bot).

MODE=autonomous
REPO=great-wall-connect/blitzlog-example
ISSUE_NUMBER=12
OPENCODE_PROMPT="Work on GitHub issue #12. Follow AGENTS.md for branch naming, implementation standards, testing, linting and commit conventions."
OPENCODE_MODEL=minimax-coding-plan/MiniMax-M3
OPENCODE_AGENT_MAX_STEPS=500
GIT_USER_NAME=John Doe
GIT_USER_EMAIL=john.doe@greatwallconnect.com
OPENCODE_API_KEY=sk-abcdefghijklmnopqrstuv

# Local LLM (uncomment to test against a local OpenAI-compatible endpoint
# such as ollama, llama.cpp server, vLLM, LM Studio, etc.):
# LOCAL_LLM_ENDPOINT=http://host.docker.internal:11434/v1
# LOCAL_LLM_MODEL=qwen2.5-coder:7b
# LOCAL_LLM_API_KEY=
# OPENCODE_MODEL=local/qwen2.5-coder:7b
# LOCAL_LLM_FALLBACK is ignored in autonomous mode (always aborts on
# unreachable local LLM — no fallback path exists for fire-and-forget runs).

# Optional: join a Tailscale Tailnet (lets the container reach endpoints
# reachable only via Tailnet, e.g., a local LLM at 100.x.y.z):
# TAILSCALE_AUTH_KEY=tskey-auth-...
# Tailscale hostname will be derived from ISSUE_NUMBER + a timestamp.