#!/bin/sh
# /usr/local/bin/blitzlog-credential-helper — a READ-ONLY GitHub
# credential helper for the blitzlog-agent container.
#
# Why this exists (issue #164):
#
#   The GitHub credential file is owned by the HOST and mounted
#   READ-ONLY into the container, so the agent can use the token but
#   cannot tamper with the host's copy. `git credential-store` is not
#   read-only in practice: after a successful authentication git calls
#   the helper's `store` operation, and credential-store REWRITES the
#   file under a lock:
#
#     fatal: unable to get credential storage lock in 1000 ms: Read-only file system
#
#   git ignores a helper's exit status, so the clone still succeeds —
#   but every assisted run logs a spurious "fatal:" that reads like a
#   failed clone, and the credential file can never be updated.
#
#   This helper implements `get` and nothing else. It reads the host's
#   file on every call — the host's token-refresh poll loop (issue
#   #145) rewrites that file IN PLACE, so the token is always current
#   — and it never writes it.
#
# How it is wired up (entrypoint.sh):
#
#   git config --global credential.helper \
#       '!/usr/local/bin/blitzlog-credential-helper'
#
#   git appends the operation to a `!`-helper's command line, so git
#   runs `/usr/local/bin/blitzlog-credential-helper get` for a lookup
#   and `... store` / `... erase` for the write paths — both of which
#   this script deliberately ignores.
set -eu

op="${1:-}"

# git writes the requested credential to the helper's stdin for every
# operation. Drain it so git's write never runs into a closed pipe.
cat >/dev/null 2>&1 || true

# Only `get` does anything. `store` and `erase` are no-ops ON PURPOSE:
# the credential file is a read-only mount, and rewriting it is exactly
# the failure this helper exists to avoid.
[ "$op" = "get" ] || exit 0

cred_file="${BLITZLOG_GIT_CREDENTIAL_FILE:-${HOME:-/home/blitzlog}/.git-credentials.d/github}"
[ -r "$cred_file" ] || exit 0

# The file holds exactly one line, written by the host
# (_bl_tokenpoll_write_git_creds in blitzlog_token_poll.sh):
#
#   https://x-access-token:<token>@github.com
#
# Split it on the FIRST ':' (username/password) and the LAST '@'
# (password/host). GitHub tokens contain neither character, so the
# split is unambiguous.
while IFS= read -r line; do
    case "$line" in
        https://*:*@*)
            cred="${line#https://}"
            username="${cred%%:*}"
            rest="${cred#*:}"
            password="${rest%@*}"
            printf 'username=%s\n' "$username"
            printf 'password=%s\n' "$password"
            exit 0
            ;;
    esac
done < "$cred_file"

exit 0
