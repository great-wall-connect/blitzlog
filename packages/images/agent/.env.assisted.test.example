# packages/images/agent/.env.assisted.test — sample env for local entrypoint smoke.
# This file is gitignored. Required: tiny.en model file mounted at
# /opt/whisper-stt/models/ggml-tiny.en.bin (download from
# https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-tiny.en.bin).

MODE=assisted
REPO=great-wall-connect/blitzlog-example
TELEGRAM_BOT_TOKEN=123115:abcdefghijklm
TELEGRAM_BOT_NAME=Blitzlog
TELEGRAM_USER_ID=123456789
ISSUE_NUMBER=2
OPENCODE_PROMPT="Work on GitHub issue #2. Follow AGENTS.md for branch naming, implementation standards, testing, linting and commit conventions. Create a PR when done."
OPENCODE_MODEL=minimax-coding-plan/MiniMax-M3
OPENCODE_AGENT_MAX_STEPS=500
STT_MODEL=tiny.en
STT_LANGUAGE=en
STT_API_KEY=local-dev-not-validated
GIT_USER_NAME=John Doe
GIT_USER_EMAIL=john.doe@greatwallconnect.com
# Uncomment for cloud LLM:
# OPENCODE_API_KEY=sk-abcdefghijklmnopqrstuv